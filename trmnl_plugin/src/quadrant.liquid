{% comment %} Styles, Gus, the map and formatted values come from shared.liquid {% endcomment %}
<div class="layout">
  <div class="satgus satgus--quadrant">
    {{ satgus_map }}

    <div class="info info--narrow">
      <table class="table">
        <tbody>
          <tr>
            <td class="text-stroke"><span class="label">Location:</span></td>
            <td class="text-stroke">{{ location }}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
