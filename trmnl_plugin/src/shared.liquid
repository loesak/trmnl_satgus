<style>
  /* Fills the view; layouts place Gus (and the map centered under him) with --gus-x/--gus-y */
  .satgus {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .satgus .map {
    position: absolute;
    top: var(--gus-y);
    left: var(--gus-x);
    /* Matches MAP_WIDTH/MAP_HEIGHT in trmnl_satgus/satgus/render_map.py */
    width: 2048px;
    height: 1792px;
    max-width: none;
    transform: translate(-50%, -50%);
  }

  .satgus .gus {
    position: absolute;
    top: var(--gus-y);
    left: var(--gus-x);
    z-index: 1000;
    transform: translate(-50%, -50%);
  }

  .satgus .gus img {
    width: 50px;
    height: 50px;
    filter: brightness(0);
  }

  .satgus .title {
    position: absolute;
    top: 20px;
    left: 30px;
    z-index: 1000;
  }

  .satgus .info {
    position: absolute;
    bottom: 32px;
    left: 15px;
    right: 15px;
    z-index: 1000;
    background: white;
    border-radius: 8px;
    border: 2px solid black;
  }

  .satgus .info .label {
    padding-left: 5px;
  }

  .satgus .footer {
    position: absolute;
    bottom: 10px;
    left: 15px;
    z-index: 1000;
  }

  /* Where Gus (and the map centered under him) sits in each layout */
  .satgus--full { --gus-x: 50%; --gus-y: 50%; }
  .satgus--half_horizontal { --gus-x: 70%; --gus-y: 50%; }
  .satgus--half_vertical { --gus-x: 50%; --gus-y: 35%; }
  .satgus--quadrant { --gus-x: 50%; --gus-y: 45%; }

  /* Info box for the smaller layouts: left-aligned, never wider than the view */
  .satgus .info--narrow {
    right: auto;
    width: min(350px, calc(100% - 30px));
  }

  .satgus .info--narrower {
    width: min(300px, calc(100% - 30px));
  }
</style>

{% comment %} Values shared by every layout, formatted here instead of in JavaScript {% endcomment %}
{% assign gus_rotation = heading_degrees | plus: 55 %}
{% assign location = location_name | default: "Area 42" %}
{% capture updated_at %}{{ timestamp | date: "%-I:%M:%S %p" }} UTC{% endcapture %}
{% comment %} Two decimals like toFixed(2); Liquid's round drops trailing zeros {% endcomment %}
{% capture fixed %}{% for n in (1..4) %}{% case n %}{% when 1 %}{% assign v = altitude_km %}{% when 2 %}{% assign v = altitude_miles %}{% when 3 %}{% assign v = velocity_km_s %}{% when 4 %}{% assign v = velocity_mps %}{% endcase %}{% assign v = v | plus: 0 | round: 2 | append: "" %}{% assign parts = v | split: "." %}{% if parts.size == 1 %}{{ v }}.00{% elsif parts[1].size == 1 %}{{ v }}0{% else %}{{ v }}{% endif %}{% unless forloop.last %}|{% endunless %}{% endfor %}{% endcapture %}
{% assign fixed = fixed | split: "|" %}
{% assign altitude_km_fixed = fixed[0] %}
{% assign altitude_miles_fixed = fixed[1] %}
{% assign velocity_km_s_fixed = fixed[2] %}
{% assign velocity_mps_fixed = fixed[3] %}

{% capture satgus_map %}
  <img class="map image-dither" src="{{ map_url }}" alt="">
  <div class="gus image-stroke image-stroke--medium image-stroke--white">
    <img src="data:image/webp;base64," alt="Gus Rocket" style="transform: rotate({{ gus_rotation }}deg)">
  </div>
  <div class="title">
    <span class="text-stroke">SAT GUS @ {{ updated_at }}</span>
  </div>
  <div class="footer">
    <span class="description text-stroke">https://github.com/loesak/trmnl_satgus</span>
  </div>
{% endcapture %}
