{% comment %} Styles, Gus, the map and formatted values come from shared.liquid {% endcomment %}
<div class="layout">
  <div class="satgus satgus--half_horizontal">
    {{ satgus_map }}

    <div class="info info--narrow info--narrower">
      <table class="table">
        <tbody>
          <tr>
            <td class="text-stroke"><span class="label">Location:</span></td>
            <td class="text-stroke" colspan="2">{{ location }}</td>
          </tr>
          <tr>
            <td class="text-stroke"><span class="label">Altitude:</span></td>
            <td class="text-stroke">{{ altitude_km_fixed }} km</td>
            <td class="text-stroke">{{ altitude_miles_fixed }} miles</td>
          </tr>
          <tr>
            <td class="text-stroke"><span class="label">Velocity:</span></td>
            <td class="text-stroke">{{ velocity_km_s_fixed }} km/s</td>
            <td class="text-stroke">{{ velocity_mps_fixed }} mi/s</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
